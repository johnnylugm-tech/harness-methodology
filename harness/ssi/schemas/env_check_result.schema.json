{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvCheckResult",
  "description": "Output written by Claude to .sessi-work/env_check_result.json after inline environment readiness evaluation.",
  "type": "object",
  "required": ["ready", "checked_at", "env_vars", "cli_tools", "infra_services", "summary"],
  "properties": {
    "ready": {
      "type": "boolean",
      "description": "True when all required items are present and verified."
    },
    "checked_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of when the check was performed."
    },
    "env_vars": {
      "type": "object",
      "description": "Required environment variables and their status.",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "present"],
            "properties": {
              "name": {"type": "string", "description": "Environment variable name."},
              "present": {"type": "boolean"},
              "fix": {"type": "string", "description": "Install/configure command if missing."}
            }
          }
        },
        "optional_missing": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional env vars with defaults that were not overridden."
        }
      }
    },
    "cli_tools": {
      "type": "object",
      "description": "Required CLI tools and their availability.",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "present"],
            "properties": {
              "name": {"type": "string", "description": "Tool name."},
              "present": {"type": "boolean"},
              "version": {"type": "string", "description": "Required version from SAD.md."},
              "fix": {"type": "string", "description": "Install command if missing."}
            }
          }
        }
      }
    },
    "infra_services": {
      "type": "object",
      "description": "Infrastructure services and their connectivity status.",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "reachable"],
            "properties": {
              "name": {"type": "string", "description": "Service name (e.g. postgres, redis)."},
              "type": {"type": "string", "description": "Service type (e.g. PostgreSQL 16, Redis 7)."},
              "reachable": {"type": "boolean"},
              "checked_via": {"type": "string", "description": "How connectivity was verified (e.g. psql -c SELECT 1)."},
              "fix": {"type": "string", "description": "Startup/configure command if unreachable."}
            }
          }
        },
        "docker_compose_services": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Expected docker compose service names from docker-compose.yml."
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary of readiness, listing any missing items and fix commands."
    }
  }
}