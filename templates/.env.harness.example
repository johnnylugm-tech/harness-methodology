# .env.harness — Harness-methodology environment variables
# Copy this file to .env in your project root.
# harness_cli.py auto-loads .env on startup (never overrides shell-level vars).

# ── Hermes MCP ────────────────────────────────────────────────────────────────
# Target channel for Hermes reviewer (A/B collaboration) and await-hermes-approve.
# Format: platform:channel  e.g.  telegram:@mychannel  slack:#quality-audit
HERMES_REVIEWER_TARGET=

# Timeout for Hermes long-poll (ms). Default: 120000 (2 min).
# Gate evaluator uses 90000 (90s); reviewer_router uses this value.
HERMES_TIMEOUT_MS=120000

# Set to "true" to enable Hermes as primary AI agent for Tier 1/2 dimension eval.
HARNESS_HERMES_ENABLED=false

# Hermes target for gate dimension evaluation (can differ from reviewer target).
HARNESS_HERMES_TARGET=slack:#quality-audit

# ── LLM Models ────────────────────────────────────────────────────────────────
# Override default models for gate evaluation.
HARNESS_GEMINI_MODEL=gemini-2.5-flash
HARNESS_CLAUDE_MODEL=claude-sonnet-4-5

# ── Gate / Phase Settings ─────────────────────────────────────────────────────
# Disable git operations (useful in CI environments without a git repo).
# HARNESS_NO_GIT=1

# ── Reviewer Chain ────────────────────────────────────────────────────────────
# Comma-separated: hermes,gemini  (sub-agent always appended as backstop)
REVIEWER_CHAIN=hermes,gemini
