# .env.harness — Harness-methodology environment variables
# Copy this file to .env in your project root.
# harness_cli.py auto-loads .env on startup (never overrides shell-level vars).

# ── LLM Models ────────────────────────────────────────────────────────────────
# Override default models for gate evaluation and software self-improvement.
# Default: claude-sonnet-4-5
HARNESS_CLAUDE_MODEL=claude-sonnet-4-5

# Override model used specifically for SSI self-improvement tasks.
# Defaults to HARNESS_CLAUDE_MODEL if unset.
HARNESS_IMPROVE_MODEL=claude-sonnet-4-5

# ── Gate / Phase Settings ─────────────────────────────────────────────────────
# Disable git operations (useful in CI environments without a git repo).
# HARNESS_NO_GIT=1

# ── Steering Settings ─────────────────────────────────────────────────────────
# Enable or disable automated runtime steering based on compliance checks.
# Default: false
STEERING_ENABLED=false

# Provider type for steering logic. (e.g. noop, file, custom)
# Default: noop
STEERING_PROVIDER_TYPE=noop
