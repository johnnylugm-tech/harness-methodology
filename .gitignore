.worktrees/

# ── claude-mem plugin runtime artifacts ────────────────────────────────────
# Auto-generated context files injected by the claude-mem MCP plugin
**/CLAUDE.md

# ── Quality-run runtime artifacts (never commit) ──────────────────────────
# SKILL.md working directory — raw tool outputs, per-round JSON, scan blobs
.sessi-work/
# Hermes plan backups — redundant with git history
.hermes/plans/backups/
# Python coverage binary
.coverage
# Ephemeral coverage snapshots emitted by quality runs
coverage_r*.json
crg_status.json
# Methodology runtime state
.methodology/effort_metrics.db
.methodology/decision_logs/
.methodology/last_block.md
.methodology/steering_history.json
.methodology/quality_manifest.json
# NOTE: .methodology/enforcement.json and quality_manifest.example.json are
#       intentional source artifacts — do NOT add them here.

# Audit reports — generated per-SHA, project-specific
.audit/

# ── Coverage artifacts ──────────────────────────────────────────────────────
coverage.json

# ── Code Review Graph runtime artifacts ─────────────────────────────────────
.code-review-graph/
.crg_dead_code_report.md

# ── Quality dashboard runtime artifacts ─────────────────────────────────────
.quality_dashboard/

# ── Tool caches ─────────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.benchmarks/

# ── Python build/test artifacts ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# ── Runtime log files ───────────────────────────────────────────────────────
logs/

# ── OS metadata ─────────────────────────────────────────────────────────────
.DS_Store
