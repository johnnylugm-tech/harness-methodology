#!/bin/bash
# =============================================================================
# pre-push hook
# =============================================================================
# Check Quality Gate before push.
# =============================================================================

set -e

# Unset git worktree env vars so all git commands resolve to this repo
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY

# Get project root directory and cd into it
PROJECT_ROOT=$(git rev-parse --show-toplevel)
cd "$PROJECT_ROOT" || { echo "[harness] ERROR: cannot cd to $PROJECT_ROOT"; exit 1; }

# Auto-detect harness_cli.py: root first, then harness/ submodule
if [ -f "$PROJECT_ROOT/harness_cli.py" ]; then
    HARNESS_CLI="$PROJECT_ROOT/harness_cli.py"
elif [ -f "$PROJECT_ROOT/harness/harness_cli.py" ]; then
    HARNESS_CLI="$PROJECT_ROOT/harness/harness_cli.py"
else
    HARNESS_CLI=""
fi

# Detect venv-aware Python (prefer project .venv over system python3)
if [ -f "$PROJECT_ROOT/.venv/bin/python" ]; then
    PYTHON="$PROJECT_ROOT/.venv/bin/python"
elif [ -f "$PROJECT_ROOT/.venv/bin/python3" ]; then
    PYTHON="$PROJECT_ROOT/.venv/bin/python3"
else
    PYTHON="python3"
fi

# Get current Phase (from state.json or default to 1)
CUR_PHASE=$("$PYTHON" -c "import json; d=json.load(open('.methodology/state.json')); print(d.get('current_phase', 1))" 2>/dev/null || echo "1")

# advance-phase writes a fixed "handover: advance to Phase N" commit but
# deliberately does NOT push it (crash-safety: a failed push must not leave
# state.json ahead of a push nobody made — see cmd_advance_phase). When this
# exact commit is HEAD, the push in flight is publishing Phase (N-1)'s
# completion, not doing Phase N's own work yet. Checking it against the
# already-flipped current_phase (N) fires delayed-blocking preflights (e.g.
# property_spec's execution requirement, fulfill_phase defaults to 4) one
# phase early, against a commit that has no way to satisfy them — that
# work belongs to Phase N's own FR implementation, which hasn't run yet.
HEAD_MSG=$(git log -1 --format=%s 2>/dev/null || echo "")
if [[ "$HEAD_MSG" =~ ^handover:\ advance\ to\ Phase\ ([0-9]+)$ ]]; then
    PHASE=$(( ${BASH_REMATCH[1]} - 1 ))
else
    PHASE="$CUR_PHASE"
fi

# Round 79 站5 — is this the framework repo, according to the repo?
#
# Everything below has a "the tool is not here, carry on" branch, which is
# right in a consuming project (it has no self-check suite and no reason to
# run one) and wrong here (this repo's push is the only thing between a red
# tree and main). The two were told apart by asking the FILESYSTEM whether a
# script existed and was executable — so a tracked self_check.sh with its
# executable bit stripped, or a checkout missing tests/REGRESSION_GUARDS.yaml,
# read as "consuming project" and every check below was skipped in silence.
#
# `git ls-files` asks the REPO instead. A file git tracks is a file this repo
# has committed to having; a chmod cannot change that answer, and neither can
# a half-finished checkout. Round 46's rule: an absent witness is not a
# passing testimony.
_IS_FRAMEWORK_REPO=false
if git ls-files --error-unmatch scripts/self_check.sh >/dev/null 2>&1; then
    _IS_FRAMEWORK_REPO=true
fi

# Names a check the framework repo cannot skip. In a consuming project the
# same condition is a legitimate "not applicable" and says so out loud.
_require_or_skip() {
    # $1 = what is missing, $2 = how to fix it
    if [ "$_IS_FRAMEWORK_REPO" = true ]; then
        echo ""
        echo "=============================================="
        echo "PRE-PUSH BLOCKED: $1"
        echo "=============================================="
        echo "This repo tracks scripts/self_check.sh, so it is the framework"
        echo "repo and its own self-check is not optional — a push that skips"
        echo "it is indistinguishable from a push that passed it, and CI is"
        echo "then the first thing to notice (Round 79: 4c24cf37 landed on main"
        echo "red on five checks this hook runs, and a project consuming the"
        echo "pin scored three FRs against it before the next commit fixed it)."
        echo ""
        echo "$2"
        exit 1
    fi
    echo "  [skip] $1 — not applicable outside the framework repo"
}

# Check if Python is available
if ! "$PYTHON" --version &>/dev/null 2>&1; then
    _require_or_skip "python not found ($PYTHON)" \
        "Create the venv (python3 -m venv .venv && .venv/bin/pip install -e '.[dev]')."
    exit 0
fi

# Check if harness CLI exists
if [ ! -f "$HARNESS_CLI" ]; then
    _require_or_skip "harness_cli.py not found under $PROJECT_ROOT" \
        "Push from the repo root, or restore the file."
    exit 0
fi

# Infrastructure-only commits (submodule pointer updates) do not change
# project code — skip the gate check. Check ALL commits being pushed;
# if every one is chore(harness):, skip. Mixed pushes (code + harness) still
# run the full check.
_ALL_HARNESS_CHORE=true
# Round 33 站5: the ranges are collected here because this loop consumes the
# hook's stdin — there is no second chance to read the refs. `break` became
# `continue` so a mixed push still records every range; the flag only ever
# moves true -> false, so the early exit was never load-bearing.
_PUSH_RANGES=""
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    if [ "$_local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue  # branch deletion — skip
    fi
    _RANGE=""
    if [ "$_remote_sha" = "0000000000000000000000000000000000000000" ]; then
        _RANGE="$_local_sha"  # new branch — all commits
    else
        _RANGE="${_remote_sha}..${_local_sha}"
    fi
    _PUSH_RANGES="$_PUSH_RANGES $_RANGE"
    _RANGE_COUNT=$(git rev-list --count "$_RANGE" 2>/dev/null || echo "0")
    if [ "$_RANGE_COUNT" -eq 0 ]; then
        _ALL_HARNESS_CHORE=false
        continue
    fi
    _NON_CHORE=$(git log "$_RANGE" --format="%s" 2>/dev/null | grep -vE '^chore\(harness\):' | head -1)
    if [ -n "$_NON_CHORE" ]; then
        _ALL_HARNESS_CHORE=false
    fi
done
if [ "$_ALL_HARNESS_CHORE" = true ]; then
    echo "All commits are infrastructure (harness submodule) — skipping gate check"
    exit 0
fi

# Regression-guard registry: block the push if any guard test was deleted
# without a matching registry update in the same commit. Framework repo only —
# target projects have no tests/REGRESSION_GUARDS.yaml, so this is a no-op there.
#
# Round 79 站5: this `if` had no `else`. When either file was absent the whole
# block — the registry check, the added-guard check, the dirty-tree gate and
# self_check.sh itself — was skipped with no output at all, so the hook's
# loudest possible failure looked exactly like its quietest success.
if [ "$_IS_FRAMEWORK_REPO" = true ] \
   && { [ ! -f "$PROJECT_ROOT/tests/REGRESSION_GUARDS.yaml" ] \
        || [ ! -f "$PROJECT_ROOT/scripts/verify_regression_guards.py" ]; }; then
    _require_or_skip "the guard registry is missing (tests/REGRESSION_GUARDS.yaml or scripts/verify_regression_guards.py)" \
        "Restore both files, then push again."
fi
if [ -f "$PROJECT_ROOT/tests/REGRESSION_GUARDS.yaml" ] && [ -f "$PROJECT_ROOT/scripts/verify_regression_guards.py" ]; then
    echo ""
    echo "Checking regression-guard registry..."
    "$PYTHON" "$PROJECT_ROOT/scripts/verify_regression_guards.py" \
        --registry "$PROJECT_ROOT/tests/REGRESSION_GUARDS.yaml" \
        --repo-root "$PROJECT_ROOT" || {
        echo ""
        echo "=============================================="
        echo "PRE-PUSH BLOCKED: regression guard missing"
        echo "=============================================="
        echo "A test listed in tests/REGRESSION_GUARDS.yaml no longer exists."
        echo "Restore it, or update the registry in the same commit with a reason."
        exit 1
    }

    # The other direction (Round 33 站5): a fix must bring its guard with it.
    # The registry only ever checked that registered guards still exist, so it
    # grew when someone remembered — measured on 8637c6a..4bdc0fb, three
    # bug-fix commits added twelve-plus tests across three new files and the
    # count did not move. Keyed on ADDED test files, which is a signal that
    # exists only here.
    _ADDED_TESTS=""
    for _r in $_PUSH_RANGES; do
        _ADDED_TESTS="$_ADDED_TESTS $(git log "$_r" --diff-filter=A --name-only --format= -- 'tests/test_*.py' 2>/dev/null)"
    done
    if [ -n "$(echo "$_ADDED_TESTS" | tr -d '[:space:]')" ]; then
        if git log $_PUSH_RANGES --format='%B' 2>/dev/null | grep -q '\[no-guard\]'; then
            echo "  [no-guard] marker in a commit message — new test files not required to register"
        else
            # shellcheck disable=SC2086  # word splitting is the point
            "$PYTHON" "$PROJECT_ROOT/scripts/verify_regression_guards.py" \
                --registry "$PROJECT_ROOT/tests/REGRESSION_GUARDS.yaml" \
                --repo-root "$PROJECT_ROOT" \
                --added-tests $_ADDED_TESTS || {
                echo ""
                echo "=============================================="
                echo "PRE-PUSH BLOCKED: new guard not registered"
                echo "=============================================="
                exit 1
            }
        fi
    fi

    # Round 67 站5: everything CI's Framework Self-Tests job runs — ruff, the
    # guard registry, the full pytest suite — from the one script that job
    # also calls. Same condition as the block above: framework repo only,
    # because a consuming project has neither this suite nor a reason to run
    # it. Of the last 25 CI runs here 12 were red, and 6 of the 9 with
    # retrievable logs failed a deterministic check this would have caught.
    # Round 78 站4: self_check measures the WORKING TREE. CI measures the
    # commit being pushed. When those differ, a green verdict here says
    # nothing about what the build will compile — commit A red, fix it on
    # disk without committing, push A: this hook passes and CI fails.
    #
    # Not hypothetical. Of the eight commits pushed between 1d111daa and
    # 70e95c9b, four were red on CI and every one was repaired by the NEXT
    # commit: 1d111daa and 0db74f4d on the file-size ratchet (fixed by
    # f893c7ae), d5549c3a on the same ratchet (fixed by c66402d1), 860b5d32
    # on ruff E741 (fixed by e35b66b8). Every one of those checks runs in
    # seconds and is in self_check.sh — which this hook had already run and
    # passed, against a tree that was not the one going out.
    #
    # Round 44's shape: the judged tree is not the recorded tree. The
    # cheapest true statement is that they must be the same tree, so a dirty
    # working tree is refused rather than measured. Untracked files count:
    # a new tests/test_*.py changes what the suite collects.
    _DIRTY=$(git status --porcelain 2>/dev/null)
    if [ -n "$_DIRTY" ]; then
        echo ""
        echo "=============================================="
        echo "PRE-PUSH BLOCKED: working tree is not the tree being pushed"
        echo "=============================================="
        echo "self-check measures what is on disk; CI measures the commit you"
        echo "are pushing. They differ right now, so a green self-check here"
        echo "would not describe the build CI is about to run:"
        echo ""
        echo "$_DIRTY" | head -10 | sed 's/^/  /'
        _DIRTY_N=$(echo "$_DIRTY" | wc -l | tr -d ' ')
        if [ "$_DIRTY_N" -gt 10 ]; then
            echo "  ... and $((_DIRTY_N - 10)) more"
        fi
        echo ""
        echo "Commit the work (git add <paths> && git commit), or set it aside"
        echo "(git stash -u), then push again."
        exit 1
    fi

    # Round 79 站5: `[ -x ]` asks the filesystem. A tracked self_check.sh whose
    # executable bit was stripped answered "no" and the most expensive check
    # this hook runs vanished without a line of output. The repo's own answer
    # (_IS_FRAMEWORK_REPO, from git ls-files) decides whether it is required;
    # `bash <script>` runs it either way, so the mode bit stops being load-
    # bearing at all.
    if [ "$_IS_FRAMEWORK_REPO" = true ] || [ -f "$PROJECT_ROOT/scripts/self_check.sh" ]; then
        # `bash <script>` rather than executing it: if the framework repo's
        # tracked self_check.sh is unreadable or gone, bash fails and the
        # block below fires. There is no branch that can decide not to run it.
        bash "$PROJECT_ROOT/scripts/self_check.sh" || {
            echo ""
            echo "=============================================="
            echo "PRE-PUSH BLOCKED: self-check failed"
            echo "=============================================="
            echo "The failing step above is one CI runs too — pushing would"
            echo "turn the build red for the same reason."
            exit 1
        }
        _SELF_CHECK=ran
    else
        echo "  [skip] no scripts/self_check.sh — not applicable outside the framework repo"
    fi
fi

# Run full Phase preflight before push (no bypass — use run-phase for complete check)
echo ""
echo "Running Phase $PHASE full preflight before push..."

"$PYTHON" "$HARNESS_CLI" run-phase --phase "$PHASE" --project "$PROJECT_ROOT"

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "=============================================="
    echo "PRE-PUSH PREFLIGHT FAILED"
    echo "=============================================="
    echo ""
    echo "Phase $PHASE run-phase checks failed."
    echo "Fix all issues before pushing."
    echo ""
    exit 1
fi

# Round 79 站5: say which checks produced this verdict. "Pre-push check
# passed!" reads the same whether self_check ran or was skipped, and the
# operator has no other way to tell — the skip printed nothing.
echo "Pre-push check passed! (framework-repo: $_IS_FRAMEWORK_REPO, self-check: ${_SELF_CHECK:-skipped}, preflight: phase $PHASE)"
exit 0
